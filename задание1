N = int(input("Введите количество чисел N: "))
numbers = []

for i in range(N):
    x = int(input(f"Введите число {i+1}: "))
    numbers.append(x)

positives = [x for x in numbers if x > 0]
negatives = [x for x in numbers if x < 0]

if not positives:
    print("Нет положительных элементов.")
elif not negatives:
    print("Нет отрицательных элементов.")
else:
    avg_pos = sum(positives) / len(positives)
    avg_neg = sum(negatives) / len(negatives)
    result = avg_pos * avg_neg
    print(f"Среднее арифметическое положительных: {avg_pos:.5f}")
    print(f"Среднее арифметическое отрицательных: {avg_neg:.5f}")
    print(f"Произведение: {result:.5f}")