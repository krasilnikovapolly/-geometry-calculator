if __name__ == "__main__":
    # Тестовый массив
    numbers = [1.0, 3.0, 2.0, 4.0, 1.0]
    d = 1.5
    
    print("Исходный массив:", numbers)
    print("Заданная величина d:", d)
    
    # Создаем объект класса
    analyzer = ArrayAnalyzer(numbers)
    
    # Вызываем метод
    result = analyzer.count_elements_dividing_parts(d)
    
    print("Количество элементов, подходящих под условие:", result)