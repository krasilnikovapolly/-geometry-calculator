class ArrayAnalyzer:
    def __init__(self, arr):
        self.arr = arr
        self.n = len(arr)

    def count_elements_dividing_parts(self, d):
        count = 0
        
        # Идем по массиву. 
        # Начинаем с индекса 1 и заканчиваем на n-1, 
        # так как у первого элемента нет левой части, а у последнего - правой.
        for i in range(1, self.n - 1):
            
            # 1. Считаем сумму слева (от 0 до i не включая i)
            sum_left = 0
            for j in range(0, i):
                sum_left += self.arr[j]
                
            # 2. Считаем сумму справа (от i+1 до конца)
            sum_right = 0
            for j in range(i + 1, self.n):
                sum_right += self.arr[j]
                
            # 3. Находим разницу (по модулю)
            diff = sum_left - sum_right
            if diff < 0:
                diff = -diff # Меняем знак, если разница отрицательная
                
            # 4. Проверяем условие
            if diff <= d:
                count += 1
                
        return count


