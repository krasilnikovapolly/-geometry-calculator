#10.4. заменяет в массиве A значения всех соседей данного элемента нулями, если данный элемент больше любого из них
class NeighborMatrix:
    def __init__(self, data):
        self.data = data
        self.rows = len(data)
        self.cols = len(data[0]) if self.rows > 0 else 0

    def replace_neighbors_with_zeros(self):
        # Создаем пустой массив-копию (без сложных срезов, просто циклами)
        result = []
        for i in range(self.rows):
            new_row = []
            for j in range(self.cols):
                new_row.append(self.data[i][j])
            result.append(new_row)

        # Проходим по каждому элементу исходного массива
        for i in range(self.rows):
            for j in range(self.cols):
                current = self.data[i][j]
                
                # Сюда будем собирать значения соседей
                neighbors = []
                
                # Проверяем соседа сверху
                if i - 1 >= 0:
                    neighbors.append(self.data[i-1][j])
                # Проверяем соседа снизу
                if i + 1 < self.rows:
                    neighbors.append(self.data[i+1][j])
                # Проверяем соседа слева
                if j - 1 >= 0:
                    neighbors.append(self.data[i][j-1])
                # Проверяем соседа справа
                if j + 1 < self.cols:
                    neighbors.append(self.data[i][j+1])
                
                # Проверяем, что текущий элемент больше всех своих соседей
                is_bigger = True
                for neighbor in neighbors:
                    if current <= neighbor:
                        is_bigger = False
                        break
                
                # Если он больше всех и соседи вообще есть
                if is_bigger == True and len(neighbors) > 0:
                    # Меняем соседей на 0 в массиве-копии (result)
                    if i - 1 >= 0:
                        result[i-1][j] = 0
                    if i + 1 < self.rows:
                        result[i+1][j] = 0
                    if j - 1 >= 0:
                        result[i][j-1] = 0
                    if j + 1 < self.cols:
                        result[i][j+1] = 0

        return result

#Проверка работы
if __name__ == "__main__":
    # Тестовый массив
    matrix = [
        [1, 2, 1],
        [2, 9, 2],
        [1, 2, 1]
    ]
    
    mat = NeighborMatrix(matrix)
    
    print("Исходный массив:")
    for row in matrix:
        print(row)
        
    result = mat.replace_neighbors_with_zeros()
    
    print("\nРезультат (соседи 9 заменены на нули):")
    for row in result:
        print(row)
